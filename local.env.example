# 本地开发敏感配置模板。复制为根目录 local.env 后填写真实值。
# local.env 已被 .gitignore 忽略，禁止提交。

# 数据库（未填写时启动脚本从 PostgreSQL 容器读取）
DB_URL=jdbc:postgresql://127.0.0.1:5432/blog_system
DB_USERNAME=postgres
DB_PASSWORD=

# 会话签名
JWT_SECRET=
SA_TOKEN_JWT_SECRET_KEY=

# Hexo 自动发布服务
PUBLICATION_BASE_URL=http://127.0.0.1:5176
PUBLICATION_API_TOKEN=
PUBLICATION_TOKEN_FILE=../blog-web/.runtime/publication.key

# Cloudflare ImgBed
IMGBED_BASE_URL=https://cloudflare-imgbed-6of.pages.dev
IMGBED_API_TOKEN=
IMGBED_UPLOAD_CHANNEL=telegram
IMGBED_CHANNEL_NAME=TelegramBot
IMGBED_ROOT_FOLDER=blog

# 音乐和 AI（按需填写）
MUSIC_PLAYLIST_ID=939817038
DASHSCOPE_API_KEY=
