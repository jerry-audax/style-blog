<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.3.2</version><relativePath/></parent>
    <groupId>com.blogsystem</groupId><artifactId>blog-server</artifactId><version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>blog-server</name>
    <description>Layered personal blog backend; one deployable application</description>
    <modules>
        <module>blog-types</module>
        <module>blog-domain</module>
        <module>blog-application</module>
        <module>blog-infrastructure</module>
        <module>blog-trigger</module>
        <module>blog-app</module>
    </modules>
    <properties><java.version>17</java.version><mybatis-plus.version>3.5.7</mybatis-plus.version><sa-token.version>1.38.0</sa-token.version></properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>1.0.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build><pluginManagement><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><systemPropertyVariables><blog.repositoryRoot>${project.basedir}/../..</blog.repositoryRoot></systemPropertyVariables></configuration>
    </plugin></plugins></pluginManagement></build>
</project>
