# Copy to deploy/.env on the server and replace every placeholder.
# This file is a template only; never commit deploy/.env.

BLOG_OWNER_PHONE=replace-with-owner-phone
BLOG_SITE_URL=https://blog.jrtitan.xyz/blog
# Existing host Nginx terminates HTTPS and forwards to this port.
BLOG_HTTP_PORT=8088
BLOG_ADMIN_PORT=5174
# Only needed with docker-compose.host-gateway.yml.
BLOG_SERVER_PORT=8080
BLOG_PUBLICATION_PORT=8081
BLOG_REDIS_PORT=6380

# PostgreSQL is external to Compose. On the supplied server it is published on 5432.
DB_URL=jdbc:postgresql://host.docker.internal:5432/blog_system
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password

# Generate both values with a password manager or: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
PUBLICATION_API_TOKEN=replace-with-another-long-random-token

IMGBED_BASE_URL=https://cloudflare-imgbed-6of.pages.dev
IMGBED_API_TOKEN=
IMGBED_UPLOAD_CHANNEL=telegram
IMGBED_CHANNEL_NAME=TelegramBot
IMGBED_ROOT_FOLDER=blog
MUSIC_PLAYLIST_ID=939817038

# PostgreSQL media metadata requires the matching existing schema before startup.
# Do not initialize or overwrite an existing database with migration/001.
MEDIA_CATALOG_STORAGE=postgres
# Enable uploads only after the upload ledger and image extension (006/013)
# are verified, real ImgBed credentials are set, and a dedicated sample passes.
MEDIA_CATALOG_UPLOADS_ENABLED=false
# This removes entries from this blog; it does not physically delete ImgBed files.
# Requires the deletion metadata/receipt schema (011).
MEDIA_CATALOG_DELETIONS_ENABLED=false
MEDIA_CATALOG_DELETIONS_ENVIRONMENT_ID=production
AI_ENABLED=false
AI_INITIALIZE_ON_STARTUP=false

