# Copy to deploy/.env on the server and replace every placeholder.
# This file is a template only; never commit deploy/.env.

BLOG_OWNER_PHONE=replace-with-owner-phone
BLOG_SITE_URL=http://47.88.48.16/blog
BLOG_HTTP_PORT=80
BLOG_ADMIN_PORT=5174

# PostgreSQL is external to Compose. On the supplied server it is published on 5432.
DB_URL=jdbc:postgresql://host.docker.internal:5432/blog_system
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password

# Generate both values with a password manager or: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
PUBLICATION_API_TOKEN=replace-with-another-long-random-token

IMGBED_BASE_URL=https://cloudflare-imgbed-6of.pages.dev
IMGBED_API_TOKEN=
IMGBED_UPLOAD_CHANNEL=telegram
IMGBED_CHANNEL_NAME=TelegramBot
IMGBED_ROOT_FOLDER=blog
MUSIC_PLAYLIST_ID=939817038

